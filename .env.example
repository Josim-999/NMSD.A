# Copy to .env, fill in, then:  set -a && . ./.env && set +a
# .env is git-ignored. Never commit a real key.

# --- Option A: local model (default, nothing leaves the network) -------------
# TIS_LLM_URL=http://127.0.0.1:11434
# TIS_LLM_MODEL=qwen2.5:7b

# --- Option B: Google Gemini (public cloud; needs both lines) ----------------
# Key from https://aistudio.google.com/apikey  (NOT a Gmail/Google One password)
# TIS_LLM_ALLOW_CLOUD=1
# TIS_GEMINI_API_KEY=AIza...
# TIS_GEMINI_MODEL=gemini-3.8-flash
