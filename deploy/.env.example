# Copy to /opt/smt/.env (chmod 600). Never commit the real file.
# Everything is optional: with nothing set, SMT runs offline, dry-run only.

# --- Owner & Telegram (approval queue, alerts, morning briefing) -----------
# Create a bot with @BotFather; get your chat id by messaging the bot and
# opening https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
SMT_OWNER_CHAT_ID=

# --- Claude (copywriting + intent detection) -------------------------------
ANTHROPIC_API_KEY=
# SMT_MODEL=claude-opus-5-5

# --- Research (official APIs only) -----------------------------------------
BRAVE_API_KEY=
YOUTUBE_API_KEY=

# --- Publishing --------------------------------------------------------------
# dryrun (default) writes payloads to outbox/. Set to live only after a week of dry runs.
SMT_PUBLISH_MODE=dryrun
# Buffer / Zapier / Make webhook that holds the TikTok, Instagram, YouTube app access
SMT_WEBHOOK_URL=
SMT_WEBHOOK_SECRET=
# Direct official APIs for text posts (override the webhook for these platforms)
X_USER_TOKEN=
LINKEDIN_TOKEN=
LINKEDIN_AUTHOR_URN=

# --- Storage / brand -----------------------------------------------------
# SMT_DB=/opt/smt/smt.db
# SMT_BRAND_FILE=/opt/smt/brand.json
